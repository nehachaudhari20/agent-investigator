{
  "services": {
    "gateway-service": {
      "type": "api_gateway",
      "depends_on": [
        "payment-service",
        "fraud-service"
      ]
    },

    "payment-service": {
      "type": "transaction_processor",
      "depends_on": [
        "ledger-service"
      ]
    },

    "fraud-service": {
      "type": "fraud_detection",
      "depends_on": [
        "risk-engine"
      ]
    },

    "ledger-service": {
      "type": "transaction_store",
      "depends_on": []
    },

    "notification-service": {
      "type": "alert_service",
      "depends_on": []
    },

    "risk-engine": {
      "type": "risk_scoring",
      "depends_on": []
    }
  }
}